# Runs the feed generator every 15 minutes. Install with: sudo cp deploy/nrk-flash.cron /etc/cron.d/nrk-flash
# Adjust the user, paths and URL. --out must be a folder your web server serves at --base-url.
*/15 * * * * www-data cd /opt/nrk-news-in-norwegian && /usr/bin/python3 nrk_flash.py --out /var/www/nrk-flash --base-url https://nrk-flash.example.no >> /var/log/nrk-flash.log 2>&1
